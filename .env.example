# Local development only. Copy to .env and choose a password.
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_USER=bluddit
POSTGRES_DB=bluddit
APP_ENV=development
LOCAL_PORT=8080
# Optional override; defaults to localhost and 127.0.0.1 using LOCAL_PORT.
# AUTH_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# API/migration PG* settings are supplied by Compose from POSTGRES_* above.
# Host integration checks require a separate disposable DB; never use member data.
# TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:25432/bluddit_test

# Blizzard public game data (optional; catalogs stay empty until configured/fetched).
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=us
BLIZZARD_LOCALE=en_US
BLIZZARD_STATIC_NAMESPACE=static-1.60.1_70399-forever-us
# Register this exact localhost callback in a development Battle.net application.
# Set all four values to enable local Battle.net sign-in; never use production secrets.
# BATTLE_NET_CLIENT_ID=
# BATTLE_NET_CLIENT_SECRET=
# BATTLE_NET_REDIRECT_URI=http://localhost:8080/api/oauth-redirect
# Generate once: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# BATTLE_NET_TOKEN_ENCRYPTION_KEY=
